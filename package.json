{
  "name": "enterprise-wdio-framework",
  "version": "1.0.0",
  "description": "Enterprise WebdriverIO Test Automation Framework",
  "main": "index.js",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "wdio run ./wdio.conf.ts",
    "test:chrome": "wdio run ./wdio.conf.ts --capabilities[0].browserName=chrome",
    "test:headless": "wdio run ./wdio.conf.ts --capabilities[0].browserName=chrome --capabilities[0].goog:chromeOptions.args=--headless",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test:ci": "npm run test:headless && npm run report:generate"
  },
  "keywords": [
    "webdriverio",
    "automation",
    "typescript",
    "mocha",
    "allure"
  ],
  "author": "QA Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.27.0",
    "expect-webdriverio": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "winston": "^3.13.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
