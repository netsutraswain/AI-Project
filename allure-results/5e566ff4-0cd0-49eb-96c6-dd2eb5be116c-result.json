       brand = \"MC\";\n                        break;\n                    case \"96\":\n                        brand = \"DISCOVER\";\n                        break;\n                    default:\n                        brand = \"UNKNOWN\";\n                        break;\n                }\n                if (brand != '' && brand != undefined) {\n                    document.getElementById('type').value = brand;\n                    document.getElementById('type').disabled = true;\n                }\n            }\n            else {\n                document.getElementById('type').value = '';\n                document.getElementById('type').disabled = false;\n            }\n            if (mytoken.value != '' && brand != '' && isCCTokenizer && !isTokenLogged ) {\n                LogToken(mytoken.value, brand);\n            }\n\n            var tokenvalue = (mytoken.value != '' && mytoken.value != undefined) ? mytoken.value : '';\n            window.parent.postMessage(\"token=\" + tokenvalue + \"&brand=\" + brand + \"&expiry=\" + expiry + \"&source=snappay\", '*');\n        }\n    }, false);\n        function onLoad() {\n            var queryString = window.location.search.substring(1);\n            if (queryString.length === 0) {\n                queryString = \"invalidinputevent=true\";\n            }\n            document.getElementById(\"tokenframe\").src = \"ajax-tokenizer.html?\" + queryString;\n            tokenProperty = scrubInput(getQueryVariable(\"tokenpropname\", \"message\"), 30, \"message\", /^[0-9a-zA-Z]+$/);\n\n        }\n\n        function getQueryVariable(variable, defaultValue) {\n            var query = window.location.search.substring(1);\n            var vars = query.split(\"&\");\n            for (var i = 0; i < vars.length; i++) {\n                var pair = vars[i].split(\"=\");\n                if (pair[0] == variable) {\n                    return pair[1];\n                }\n            }\n            return defaultValue ? defaultValue : (false);\n        }\n\n        function scrubInput(input, maxlen, fallback, pattern) {\n            if (input && input.length !== 0 && input.length <= maxlen) {\n                if (input.match(pattern)) {\n                    return input;\n                }\n            }\n            return fallback;\n\n        }\n    function LogToken(token, brand) {\n        var stateInfo = \"\";\n        $.ajax({\n            cache: false,\n            url: '/Interop/InteropCCAjaxTokenizer/LogToken',\n            type: \"POST\",\n            async: false,\n            dataType: \"json\",\n            data: { token: token, brand: brand },\n            success: function (data) {\n                isTokenLogged = true;\n                stateInfo = data.success;\n            },\n            error: function (request, status, error) {\n                isTokenLogged = false;\n                stateInfo = error;\n            }\n        });\n        return stateInfo;\n    }\n     function isValidJSON(jsonString) {\n            try {\n                // Attempt to parse the string. If it's not valid JSON, this will throw an error.\n                JSON.parse(jsonString);\n                return true; // If parsing succeeds, the string is valid JSON.\n            } catch (error) {\n                // If an error is caught, the string is not valid JSON.\n                return false;\n            }\n    }\n\n    var maxIframeRetries = 3;\n    var iframeRetryCount = 0;\n    var iframeLoaded = false;\n    var iframeTimeout = null;\n    var baseTimeoutMs = 2000;\n    var currentAttemptId = 0;\n    var messageTimeout = null;\n    var messageTimeoutMs = 4000;\n    var messageListenerAttached = false;\n    function htmlDecode(input) {\n        var doc = new DOMParser().parseFromString(input, \"text/html\");\n        return doc.documentElement.textContent;\n    }\n    function setIframeSrcWithRetry(src) {\n        src = htmlDecode(src);\n        const iframe = document.getElementById(\"tokenframe\");\n        // enable cssLoaded checking only when sendcssloadedevent=true present in URL\n        const checkCssLoaded = src.toLowerCase().includes(\"sendcssloadedevent=true\");\n        function markIframeLoaded() {\n            if (iframeLoaded) return;\n            iframeLoaded = true;\n            clearTimeout(iframeTimeout);\n            clearTimeout(messageTimeout);\n\n            // Only send ready message when checkCssLoaded is enabled\n            if (checkCssLoaded) {\n                window.parent.postMessage(\n                    {\n                        status: \"ready\",\n                        message: \"Payment iframe loaded successfully.\",\n                        source: \"snappay\",\n                    },\n                    \"*\"\n                );\n            }\n        }\n        function handleIframeFailure(reason, attemptId) {\n            if (iframeLoaded || attemptId !== currentAttemptId) return;\n            clearTimeout(iframeTimeout);\n            clearTimeout(messageTimeout);\n            if (iframeRetryCount < maxIframeRetries) {\n                iframeRetryCount++;\n                const retryDelay = baseTimeoutMs * Math.pow(2, iframeRetryCount - 1);\n\n                // Only send retry message when checkCssLoaded is enabled\n                if (checkCssLoaded) {\n                    window.parent.postMessage(\n                        {\n                            status: \"retrying\",\n                            message: `Iframe load failed (${reason}). Retrying in ${retryDelay / 1000}s (attempt ${iframeRetryCount}/${maxIframeRetries})...`,\n                            source: \"snappay\",\n                        },\n                        \"*\"\n                    );\n                }\n                setTimeout(() => {\n                    if (!iframeLoaded) tryLoad();\n                }, retryDelay);\n            } else {\n                // Only send error message when checkCssLoaded is enabled\n                if (checkCssLoaded) {\n                    window.parent.postMessage(\n                        {\n                            status: \"error\",\n                            message: `Payment iframe failed after ${maxIframeRetries} attempts. Last error: ${reason}`,\n                            source: \"snappay\",\n                        },\n                        \"*\"\n                    );\n                }\n            }\n        }\n        function tryLoad() {\n            if (iframeLoaded) return;\n            iframeLoaded = false;\n            currentAttemptId++;\n            const attemptId = currentAttemptId;\n            const retryParam = (src.indexOf(\"?\") > -1 ? \"&\" : \"?\") + \"retry=\" + iframeRetryCount;\n            const iframeUrl = src + retryParam;\n            iframe.src = iframeUrl;\n            const timeoutMs = baseTimeoutMs * Math.pow(2, iframeRetryCount);\n            iframeTimeout = setTimeout(() => {\n                if (!iframeLoaded) handleIframeFailure(\"Timeout / no response\", attemptId);\n            }, timeoutMs);\n        }\n        // Add message listener only if cssLoaded check is enabled\n        if (checkCssLoaded && !messageListenerAttached) {\n            window.addEventListener(\"message\", function eventHandler(event) {\n                if (!event || !event.data) return;\n                let data = event.data;\n                if (typeof data === \"string\") {\n                    try {\n                        data = JSON.parse(data);\n                    } catch (err) {\n                        console.warn(\"Could not parse message data:\", event.data);\n                        return;\n                    }\n                }\n                // Only act if cssLoaded true\n                if (data.cssLoaded === true) {\n                    markIframeLoaded();\n                }\n            });\n            messageListenerAttached = true;\n        }\n        iframe.onload = () => {\n            clearTimeout(iframeTimeout);\n            if (!checkCssLoaded) {\n                // No cssLoaded tracking needed — mark as loaded immediately\n                markIframeLoaded();\n                return;\n            }\n            // Otherwise, wait for cssLoaded message from iframe\n            messageTimeout = setTimeout(() => {\n                if (!iframeLoaded) {\n                    handleIframeFailure(\"no message received from iframe.\", currentAttemptId);\n                }\n            }, messageTimeoutMs);\n        };\n        iframe.onerror = () => {\n            if (!iframeLoaded && checkCssLoaded)\n                handleIframeFailure(\"Network error while loading iframe.\", currentAttemptId);\n        };\n        iframe.onabort = () => {\n            if (!iframeLoaded && checkCssLoaded)\n                handleIframeFailure(\"Load aborted.\", currentAttemptId);\n        };\n        tryLoad();\n    }\n\n    // Call this on page load or when you want to start loading the iframe\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        if ('True' == 'True') {\n            setIframeSrcWithRetry(\"https://girlscouts-uat.cardconnect.com/itoke/ajax-tokenizer.html?invalidinputevent=true&amp;useexpiry=true&amp;usecvv=true&amp;cardlabel=Credit/Debit Card Number&amp;placeholder=Credit/Debit Card Number&amp;placeholdercvv=CVV&amp;placeholdermonth=MM&amp;placeholderyear=YYYY&amp;css=.error%7B+color%3A+red%3B+border-color%3Ared%3B+%7D%3Binput%7Bwidth%3A+669px%3B+max-width%3A+calc(100%25+-+16px)%3B+box-sizing%3A+border-box%3B+height%3A+160px%3B+max-height%3A+35px%3B+margin-bottom%3A+10px%3B+margin-top%3A5px%3B+margin-left%3A+0%3B+margin-right%3A+0%3B+border%3A+1px+solid+%23d3d6db%3Bpadding%3A10px%3Bfont-weight%3A+400%3Bfont-size%3A12px%3Bline-height%3A+1.5%3Bcolor%3A+%23495057%3Boutline%3A+none%3Bfont-family%3A+%22Trefoil+Sans+Regular%22%3B%7D\");\n        }\n        else {\n            setIframeSrcWithRetry(\"https://stage.snappayglobal.com/UPIUI/singlefieldto