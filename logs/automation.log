<script language="JavaScript">
    var tokenProperty;
    var isCCTokenizer = true;
    var isTokenLogged = true;

    window.addEventListener('message', function (event) {
        // Ignore messages from snappay source to prevent infinite loop
        if (event.data && typeof event.data === 'object' && (event.data.source === 'snappay' || event.data.source === 'react-devtools-content-script')) {
            return;
        }

        // Ignore messages from snappay in string format
        if (typeof event.data === 'string' && event.data.includes('source=snappay')) {
            return;
        }

        if ('none' == 'upi') {
            window.parent.postMessage(event.data, '*');
        }
        else {
            var mytoken = document.getElementById('token');
            var tokenError = document.getElementById('tokenError');
            var expiry = '';

            if ('True' == 'True') {
                isCCTokenizer = true;
                if (isValidJSON(event.data)) {
                    var token = JSON.parse(event.data);
                    mytoken.value = token.message;
                    tokenError.value = token.validationError;
                    expiry = token.expiry;
                    isTokenLogged = false;
                }
            }
            else {
                isCCTokenizer = false;
                var upitoken = (typeof event.data == "string") ? JSON.parse(JSON.stringify(event.data)) : event.data;
                if (typeof event.data == "string" && event.data.includes('success')) {
                    var objToken = JSON.parse(upitoken);
                    mytoken.value = objToken.token != undefined ? objToken.token : '';
                    tokenError.value = objToken.message != undefined ? objToken.message : '';
                }
            }

            var brand = '';
            if (mytoken.value != '' && mytoken.value != undefined) {
                var tokenizedVal = mytoken.value.substr(0, 2);
                switch (tokenizedVal) {
                    case "93":
                        brand = "AMEX";
                        break;
                    case "94":
                        brand = "VISA";
                        break;
                    case "95":
                    case "92":
                        brand = "MC";
                        break;
                    case "96":
                        brand = "DISCOVER";
                        break;
                    default:
                        brand = "UNKNOWN";
                        break;
                }
                if (brand != '' && brand != undefined) {
                    document.getElementById('type').value = brand;
                    document.getElementById('type').disabled = true;
                }
            }
            else {
                document.getElementById('type').value = '';
                document.getElementById('type').disabled = false;
            }
            if (mytoken.value != '' && brand != '' && isCCTokenizer && !isTokenLogged ) {
                LogToken(mytoken.value, brand);
            }

            var tokenvalue = (mytoken.value != '' && mytoken.value != undefined) ? mytoken.value : '';
            window.parent.postMessage("token=" + tokenvalue + "&brand=" + brand + "&expiry=" + expiry + "&source=snappay", '*');
        }
    }, false);
        function onLoad() {
            var queryString = window.location.search.substring(1);
            if (queryString.length === 0) {
                queryString = "invalidinputevent=true";
            }
            document.getElementById("tokenframe").src = "ajax-tokenizer.html?" + queryString;
            tokenProperty = scrubInput(getQueryVariable("tokenpropname", "message"), 30, "message", /^[0-9a-zA-Z]+$/);

        }

        function getQueryVariable(variable, defaultValue) {
            var query = window.location.search.substring(1);
            var vars = query.split("&");
            for (var i = 0; i < vars.length; i++) {
                var pair = vars[i].split("=");
                if (pair[0] == variable) {
                    return pair[1];
                }
            }
            return defaultValue ? defaultValue : (false);
        }

        function scrubInput(input, maxlen, fallback, pattern) {
            if (input && input.length !== 0 && input.length <= maxlen) {
                if (input.match(pattern)) {
                    return input;
                }
            }
            return fallback;

        }
    function LogToken(token, brand) {
        var stateInfo = "";
        $.ajax({
            cache: false,
            url: '/Interop/InteropCCAjaxTokenizer/LogToken',
            type: "POST",
            async: false,
            dataType: "json",
            data: { token: token, brand: brand },
            success: function (data) {
                isTokenLogged = true;
                stateInfo = data.success;
            },
            error: function (request, status, error) {
                isTokenLogged = false;
                stateInfo = error;
            }
        });
        return stateInfo;
    }
     function isValidJSON(jsonString) {
            try {
                // Attempt to parse the string. If it's not valid JSON, this will throw an error.
                JSON.parse(jsonString);
                return true; // If parsing succeeds, the string is valid JSON.
            } catch (error) {
                // If an error is caught, the string is not valid JSON.
                return false;
            }
    }

    var maxIframeRetries = 3;
    var iframeRetryCount = 0;
    var iframeLoaded = false;
    var iframeTimeout = null;
    var baseTimeoutMs = 2000;
    var currentAttemptId = 0;
    var messageTimeout = null;
    var messageTimeoutMs = 4000;
    var messageListenerAttached = false;
    function htmlDecode(input) {
        var doc = new DOMParser().parseFromString(input, "text/html");
        return doc.documentElement.textContent;
    }
    function setIframeSrcWithRetry(src) {
        src = htmlDecode(src);
        const iframe = document.getElementById("tokenframe");
        // enable cssLoaded checking only when sendcssloadedevent=true present in URL
        const checkCssLoaded = src.toLowerCase().includes("sendcssloadedevent=true");
        function markIframeLoaded() {
            if (iframeLoaded) return;
            iframeLoaded = true;
            clearTimeout(iframeTimeout);
            clearTimeout(messageTimeout);

            // Only send ready message when checkCssLoaded is enabled
            if (checkCssLoaded) {
                window.parent.postMessage(
                    {
                        status: "ready",
                        message: "Payment iframe loaded successfully.",
                        source: "snappay",
                    },
                    "*"
                );
            }
        }
        function handleIframeFailure(reason, attemptId) {
            if (iframeLoaded || attemptId !== currentAttemptId) return;
            clearTimeout(iframeTimeout);
            clearTimeout(messageTimeout);
            if (iframeRetryCount < maxIframeRetries) {
                iframeRetryCount++;
                const retryDelay = baseTimeoutMs * Math.pow(2, iframeRetryCount - 1);

                // Only send retry message when checkCssLoaded is enabled
                if (checkCssLoaded) {
                    window.parent.postMessage(
                        {
                            status: "retrying",
                            message: `Iframe load failed (${reason}). Retrying in ${retryDelay / 1000}s (attempt ${iframeRetryCount}/${maxIframeRetries})...`,
                            source: "snappay",
                        },
                        "*"
                    );
                }
                setTimeout(() => {
                    if (!iframeLoaded) tryLoad();
                }, retryDelay);
            } else {
                // Only send error message when checkCssLoaded is enabled
                if (checkCssLoaded) {
                    window.parent.postMessage(
                        {
                            status: "error",
                            message: `Payment iframe failed after ${maxIframeRetries} attempts. Last error: ${reason}`,
                            source: "snappay",
                        },
                        "*"
                    );
                }
            }
        }
        function tryLoad() {
            if (iframeLoaded) return;
            iframeLoaded = false;
            currentAttemptId++;
            const attemptId = currentAttemptId;
            const retryParam = (src.indexOf("?") > -1 ? "&" : "?") + "retry=" + iframeRetryCount;
            const iframeUrl = src + retryParam;
            iframe.src = iframeUrl;
            const timeoutMs = baseTimeoutMs * Math.pow(2, iframeRetryCount);
            iframeTimeout = setTimeout(() => {
                if (!iframeLoaded) handleIframeFailure("Timeout / no response", attemptId);
            }, timeoutMs);
        }
        // Add message listener only if cssLoaded check is enabled
        if (checkCssLoaded && !messageListenerAttached) {
            window.addEventListener("message", function eventHandler(event) {
                if (!event || !event.data) return;
                let data = event.data;
                if (typeof data === "string") {
                    try {
                        data = JSON.parse(data);
                    } catch (err) {
                        console.warn("Could not parse message data:", event.data);
                        return;
                    }
                }
                // Only act if cssLoaded true
                if (data.cssLoaded === true) {
                    markIframeLoaded();
                }
            });
            messageListenerAttached = true;
        }
        iframe.onload = () => {
            clearTimeout(iframeTimeout);
            if (!checkCssLoaded) {
                // No cssLoaded tracking needed — mark as loaded immediately
                markIframeLoaded();
                return;
            }
            // Otherwise, wait for cssLoaded message from iframe
            messageTimeout = setTimeout(() => {
                if (!iframeLoaded) {
                    handleIframeFailure("no message received from iframe.", currentAttemptId);
                }
            }, messageTimeoutMs);
        };
        iframe.onerror = () => {
            if (!iframeLoaded && checkCssLoaded)
                handleIframeFailure("Network error while loading iframe.", currentAttemptId);
        };
        iframe.onabort = () => {
            if (!iframeLoaded && checkCssLoaded)
                handleIframeFailure("Load aborted.", currentAttemptId);
        };
        tryLoad();
    }

    // Call this on page load or when you want to start loading the iframe
    document.addEventListener("DOMContentLoaded", function () {
        if ('True' == 'True') {
            setIframeSrcWithRetry("https://girlscouts-uat.cardconnect.com/itoke/ajax-tokenizer.html?invalidinputevent=true&amp;useexpiry=true&amp;usecvv=true&amp;cardlabel=Credit/Debit Card Number&amp;placeholder=Credit/Debit Card Number&amp;placeholdercvv=CVV&amp;placeholdermonth=MM&amp;placeholderyear=YYYY&amp;css=.error%7B+color%3A+red%3B+border-color%3Ared%3B+%7D%3Binput%7Bwidth%3A+669px%3B+max-width%3A+calc(100%25+-+16px)%3B+box-sizing%3A+border-box%3B+height%3A+160px%3B+max-height%3A+35px%3B+margin-bottom%3A+10px%3B+margin-top%3A5px%3B+margin-left%3A+0%3B+margin-right%3A+0%3B+border%3A+1px+solid+%23d3d6db%3Bpadding%3A10px%3Bfont-weight%3A+400%3Bfont-size%3A12px%3Bline-height%3A+1.5%3Bcolor%3A+%23495057%3Boutline%3A+none%3Bfont-family%3A+%22Trefoil+Sans+Regular%22%3B%7D");
        }
